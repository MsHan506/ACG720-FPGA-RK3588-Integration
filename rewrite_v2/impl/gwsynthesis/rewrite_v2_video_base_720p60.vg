`pragma protect end_protected
module DVI_TX_Top (
  pixel_clk,
  serial_clk_x5,
  n59_4,
  vsync_Z,
  hsync_Z,
  rgb_Z_7,
  rgb_Z_15,
  rgb_Z_23,
  tmds_clk_p,
  tmds_clk_n,
  tmds_data_p,
  tmds_data_n
)
;
input pixel_clk;
input serial_clk_x5;
input n59_4;
input vsync_Z;
input hsync_Z;
input rgb_Z_7;
input rgb_Z_15;
input rgb_Z_23;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .pixel_clk(pixel_clk),
    .serial_clk_x5(serial_clk_x5),
    .n59_4(n59_4),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .rgb_Z_7(rgb_Z_7),
    .rgb_Z_15(rgb_Z_15),
    .rgb_Z_23(rgb_Z_23),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module video_base_top (
  clk50M,
  reset_n,
  tmds_clk_p,
  tmds_clk_n,
  tmds_data_p,
  tmds_data_n,
  led
)
;
input clk50M;
input reset_n;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
output [3:0] led;
wire clk50M_d;
wire reset_n_d;
wire n59_4;
wire pixel_clk;
wire led_d_1_4;
wire serial_clk_x5;
wire video_reset;
wire hsync_Z;
wire vsync_Z;
wire n149_4;
wire led_d_2_3;
wire [0:0] led_d;
wire [10:5] x_Z;
wire [9:8] y_Z;
wire [3:2] led_d_0;
wire [23:7] rgb_Z;
wire VCC;
wire GND;
  IBUF clk50M_ibuf (
    .O(clk50M_d),
    .I(clk50M) 
);
  IBUF reset_n_ibuf (
    .O(reset_n_d),
    .I(reset_n) 
);
  OBUF led_0_obuf (
    .O(led[0]),
    .I(led_d[0]) 
);
  OBUF led_1_obuf (
    .O(led[1]),
    .I(led_d_1_4) 
);
  OBUF led_2_obuf (
    .O(led[2]),
    .I(led_d_0[2]) 
);
  OBUF led_3_obuf (
    .O(led[3]),
    .I(led_d_0[3]) 
);
  LUT2 n59_s0 (
    .F(n59_4),
    .I0(video_reset),
    .I1(led_d_0[2]) 
);
defparam n59_s0.INIT=4'h4;
  CLKDIV u_pixel_div (
    .CLKOUT(pixel_clk),
    .HCLKIN(serial_clk_x5),
    .RESETN(VCC),
    .CALIB(VCC) 
);
defparam u_pixel_div.DIV_MODE="5";
  INV led_d_1_s0 (
    .O(led_d_1_4),
    .I(video_reset) 
);
  camera_pll u_video_pll (
    .clk50M_d(clk50M_d),
    .serial_clk_x5(serial_clk_x5),
    .led_d(led_d[0])
);
  reset_release u_reset_release (
    .pixel_clk(pixel_clk),
    .reset_n_d(reset_n_d),
    .led_d(led_d[0]),
    .video_reset(video_reset)
);
  video_timing_720p60 u_timing (
    .pixel_clk(pixel_clk),
    .video_reset(video_reset),
    .hsync_Z(hsync_Z),
    .vsync_Z(vsync_Z),
    .n149_4(n149_4),
    .led_d_2_3(led_d_2_3),
    .x_Z(x_Z[10:5]),
    .y_Z(y_Z[9:8]),
    .led_d(led_d_0[3:2])
);
  colour_bars u_bars (
    .n149_4(n149_4),
    .led_d_2_3(led_d_2_3),
    .x_Z(x_Z[10:5]),
    .led_d(led_d_0[2]),
    .y_Z(y_Z[9:8]),
    .rgb_Z_7(rgb_Z[7]),
    .rgb_Z_15(rgb_Z[15]),
    .rgb_Z_23(rgb_Z[23])
);
  DVI_TX_Top u_dvi_tx (
    .pixel_clk(pixel_clk),
    .serial_clk_x5(serial_clk_x5),
    .n59_4(n59_4),
    .vsync_Z(vsync_Z),
    .hsync_Z(hsync_Z),
    .rgb_Z_7(rgb_Z[7]),
    .rgb_Z_15(rgb_Z[15]),
    .rgb_Z_23(rgb_Z[23]),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* video_base_top */
